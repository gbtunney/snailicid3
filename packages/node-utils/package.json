{
    "name": "@snailicid3/node-utils",
    "version": "0.2.0",
    "private": false,
    "description": "Node.js filesystem, path, zod schemas, and package.json utilities",
    "keywords": [
        "typescript",
        "snailicid3",
        "monorepo",
        "node",
        "filesystem",
        "path",
        "glob",
        "yargs"
    ],
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "dev:nx": "nx run $npm_package_name:dev",
        "api:report:nx": "nx run $npm_package_name:api:report"
    },
    "nx": {
        "implicitDependencies": [
            "!@snailicid3/config"
        ],
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:tsdown": {},
            "check:ts": {
                "inputs": [
                    "default",
                    "^production",
                    "{workspaceRoot}/packages/config/typescript-config/**/*"
                ]
            },
            "build:ts": {
                "inputs": [
                    "production",
                    "^production",
                    "{workspaceRoot}/packages/config/typescript-config/**/*"
                ]
            },
            "build:tsdown": {},
            "build": {
                "dependsOn": [
                    "build:ts",
                    "build:tsdown"
                ]
            },
            "api:report": {},
            "api:check": {},
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {}
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "types"
    ],
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/snailicid3",
        "directory": "packages/node-utils"
    },
    "dependencies": {
        "@snailicid3/utils": "workspace:*",
        "@types/is-glob": "^4.0.4",
        "@types/micromatch": "^4.0.10",
        "glob": "^13.0.6",
        "is-glob": "^4.0.3",
        "micromatch": "^4.0.8",
        "ramda-adjunct": "^6.1.0",
        "ts-deepmerge": "^8.0.0",
        "type-fest": "^5.7.0",
        "yargs": "^18.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.0",
        "@snailicid3/config": "workspace:*",
        "@types/node": "^26.2.0",
        "@types/yargs": "^17.0.35",
        "tsdown": "^0.22.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts"
}
