{
    "name": "@snailicid3/logger",
    "version": "0.1.0",
    "private": false,
    "description": "Unified Node logger with Ansis terminal output and a shell adapter",
    "keywords": [
        "typescript",
        "snailicid3",
        "monorepo",
        "logger",
        "ansis",
        "logging",
        "node"
    ],
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "dev:nx": "nx run $npm_package_name:dev",
        "demo": "pnpm exec nx run $npm_package_name:check:ts && pnpm exec tsx ./src/demo-cli.ts",
        "demo:levels": "pnpm exec nx run $npm_package_name:check:ts && pnpm exec tsx ./src/demo-cli.ts levels",
        "demo:spinner": "pnpm exec nx run $npm_package_name:check:ts && pnpm exec tsx ./src/demo-cli.ts spinner",
        "demo:all": "pnpm exec nx run $npm_package_name:check:ts && pnpm exec tsx ./src/demo-cli.ts all"
    },
    "nx": {
        "implicitDependencies": [
            "!@snailicid3/config"
        ],
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:tsdown": {},
            "build:ts": {},
            "check:ts": {},
            "build:tsdown": {},
            "build": {
                "dependsOn": [
                    "build:ts",
                    "build:tsdown"
                ]
            },
            "api:report": {},
            "api:check": {},
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {}
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "bin": {
        "snail-sh": "./dist/snail-sh.mjs"
    },
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./demo": {
            "types": "./dist/demo.d.mts",
            "import": "./dist/demo.mjs",
            "default": "./dist/demo.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "types"
    ],
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/snailicid3",
        "directory": "packages/logger"
    },
    "dependencies": {
        "@snailicid3/color": "workspace:*",
        "@snailicid3/node-utils": "workspace:*",
        "ansis": "^4.3.1",
        "cli-table3": "^0.6.5",
        "dayjs": "^1.11.21",
        "ora": "^9.4.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.58.8",
        "@snailicid3/build-config": "workspace:*",
        "@snailicid3/config": "workspace:*",
        "@types/node": "^26.2.0",
        "tsdown": "^0.22.2",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    },
    "module": "./dist/index.js"
}
