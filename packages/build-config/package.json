{
    "name": "@snailicid3/build-config",
    "version": "0.0.8",
    "private": false,
    "description": "Typed tsdown, Vite and Vitest config factories with a shared build-plan model",
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "api:report:nx": "nx run $npm_package_name:api:report"
    },
    "nx": {
        "implicitDependencies": [
            "!@snailicid3/config"
        ],
        "targets": {
            "dev": {},
            "dev:ts": {},
            "build:ts": {
                "inputs": [
                    "production",
                    "^production",
                    "{workspaceRoot}/packages/config/typescript-config/**/*"
                ],
                "outputs": [
                    "{projectRoot}/dist",
                    "{projectRoot}/types"
                ]
            },
            "check:ts": {},
            "build": {
                "dependsOn": [
                    "build:ts"
                ]
            },
            "api:report": {},
            "api:check": {},
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {}
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "typescript",
        "snailicid3",
        "monorepo",
        "rollup",
        "vite",
        "tsdown",
        "vitest",
        "typedoc",
        "build",
        "bundler"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./tsdown": {
            "types": "./types/adapters/tsdown/index.d.ts",
            "import": "./dist/adapters/tsdown/index.js",
            "default": "./dist/adapters/tsdown/index.js"
        },
        "./vite": {
            "types": "./types/adapters/vite/index.d.ts",
            "import": "./dist/adapters/vite/index.js",
            "default": "./dist/adapters/vite/index.js"
        },
        "./vitest": {
            "types": "./types/vitest/index.d.ts",
            "import": "./dist/vitest/index.js",
            "default": "./dist/vitest/index.js"
        },
        "./plan": {
            "types": "./types/build/plan.d.ts",
            "import": "./dist/build/plan.js",
            "default": "./dist/build/plan.js"
        },
        "./banner": {
            "types": "./types/build/banner.d.ts",
            "import": "./dist/build/banner.js",
            "default": "./dist/build/banner.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "types"
    ],
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/snailicid3",
        "directory": "packages/build-config"
    },
    "dependencies": {
        "@snailicid3/node-utils": "workspace:*",
        "ts-deepmerge": "^8.0.0",
        "ts-extras": "^1.0.0",
        "tsdown": "^0.22.2",
        "type-fest": "^5.7.0",
        "vite": "^8.0.16",
        "vite-plugin-dts": "^5.0.2",
        "zod": "^4.4.2"
    },
    "peerDependencies": {
        "vitest": "^4.1.9"
    },
    "peerDependenciesMeta": {
        "vitest": {
            "optional": true
        }
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.58.8",
        "@snailicid3/config": "workspace:*",
        "@types/node": "^26.2.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    }
}
