{
    "name": "@snailicid3/utils",
    "version": "0.1.0",
    "private": false,
    "description": "String, numeric, object, date and fmt utilities",
    "keywords": [
        "typescript",
        "snailicid3",
        "monorepo",
        "utilities",
        "string",
        "numeric",
        "date",
        "format"
    ],
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "docs:nx": "nx run $npm_package_name:docs:build",
        "docs:serve:nx": "nx run $npm_package_name:docs:serve",
        "api:report:nx": "nx run $npm_package_name:api:report"
    },
    "nx": {
        "implicitDependencies": [
            "!@snailicid3/config"
        ],
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:tsdown": {},
            "build:ts": {},
            "build:tsdown": {},
            "build": {
                "dependsOn": [
                    "build:ts",
                    "build:tsdown"
                ]
            },
            "api:report": {},
            "api:check": {},
            "check:ts": {},
            "test": {},
            "test:nx": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {},
            "docs:build": {},
            "docs:build:ts": {},
            "docs:serve": {}
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.cts",
    "unpkg": "./dist/index.iife.js",
    "jsdelivr": "./dist/index.iife.js",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "types"
    ],
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/snailicid3",
        "directory": "packages/utils"
    },
    "dependencies": {
        "@snailicid3/types": "workspace:*",
        "dayjs": "^1.11.23",
        "escape-string-regexp": "^5.0.0",
        "flat": "^6.0.1",
        "minimatch": "^10.2.5",
        "ramda": "^0.32.0",
        "ramda-adjunct": "^6.1.0",
        "semver": "^7.8.4",
        "sprintf-js": "^1.1.3",
        "ts-deepmerge": "^8.0.0",
        "type-fest": "^5.7.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.0",
        "@snailicid3/config": "workspace:*",
        "@types/node": "^26.2.0",
        "@types/ramda": "^0.32.0",
        "@types/semver": "^7.8.0",
        "@types/sprintf-js": "^1.1.4",
        "tsdown": "^0.22.2",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "module": "./dist/index.js"
}
