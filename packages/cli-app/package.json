        "tsdown": "^0.22.2",
        "tsx": "^4.23.12",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    },
    "bin": {
        "cli-app-example": "./dist/example.mjs"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": "./dist/index.mjs",
        "./example": "./dist/example.mjs",
        "./package.json": "./package.json"
    },
    "keywords": [
        "typescript",
        "snailicid3",
        "monorepo",
        "cli",
        "framework",
        "zod",
        "yargs"
    ],
    "publishConfig": {
        "access": "public"
    },
