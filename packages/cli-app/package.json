{
    "name": "@snailicid3/cli-app",
    "version": "0.1.0",
    "private": false,
    "description": "Zod-backed CLI app framework",
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "dev:nx": "nx run $npm_package_name:dev",
        "api:report:nx": "nx run $npm_package_name:api:report",
        "test:example": "nx run $npm_package_name:check:ts && pnpm exec tsx ./src/example/index.ts --help",
        "test:example:cli": "pnpm run build:nx && nx run $npm_package_name:check:ts && pnpm exec node ./dist/example.mjs --help"
    },
    "nx": {
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:tsdown": {},
            "build:ts": {},
            "check:ts": {},
            "build:tsdown": {},
            "build": {
                "dependsOn": [
                    "build:ts",
                    "build:tsdown"
                ]
            },
            "api:report": {},
            "api:check": {},
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {},
            "docs:build:ts": {},
            "docs:build": {}
        }
    },
    "dependencies": {
        "@snailicid3/color": "workspace:*",
        "@snailicid3/logger": "workspace:*",
        "@snailicid3/node-utils": "workspace:*",
        "@snailicid3/utils": "workspace:*",
        "chalk": "^6.0.0",
        "figlet": "^1.11.0",
        "type-fest": "^5.7.0",
        "yargs": "^18.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.58.8",
        "@snailicid3/build-config": "workspace:*",
        "@snailicid3/config": "workspace:*",
        "@types/node": "^26.1.2",
        "@types/yargs": "^17.0.35",
        "tsdown": "^0.22.2",
        "tsx": "^4.23.1",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    },
    "bin": {
        "cli-app-example": "./dist/example.mjs"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": "./dist/index.mjs",
        "./example": "./dist/example.mjs",
        "./package.json": "./package.json"
    },
    "keywords": [
        "typescript",
        "snailicid3",
        "monorepo",
        "cli",
        "framework",
        "zod",
        "yargs"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "files": [
        "CHANGELOG.md",
        "dist",
        "types"
    ],
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/snailicid3",
        "directory": "packages/cli-app"
    }
}
