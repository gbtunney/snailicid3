{
    "name": "@snailicid3/cli-app",
    "version": "0.1.0",
    "private": false,
    "description": "Zod-backed CLI app framework",
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "dev:nx": "nx run $npm_package_name:dev",
        "api:report:nx": "nx run $npm_package_name:api:report",
        "test:example": "nx run $npm_package_name:check:ts && pnpm exec tsx ./src/example/index.ts --help",
        "test:example:cli": "pnpm run build:nx && nx run $npm_package_name:check:ts && pnpm exec node ./dist/example.mjs  --help"
    },
    "nx": {
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:tsdown": {},
            "build:ts": {},
            "check:ts": {},
            "build:tsdown": {},
            "build": {
                "dependsOn": [
                    "build:ts",
                    "build:tsdown"
                ]
            },
            "api:report": {},
            "api:check": {},
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {},
            "docs:build:ts": {},
            "docs:build": {}
        }
    },
    "dependencies": {
        "@snailicid3/color": "workspace:*",
        "@snailicid3/logger": "workspace:*",
        "@snailicid3/node-utils": "workspace:*",
        "@snailicid3/utils": "workspace:*",
        "chalk": "^6.0.0",
        "figlet": "^1.11.0",
        "ora": "^9.4.1",
        "type-fest": "^5.7.0",
        "yargs": "^18.0.0",
        "zod": "^4.3.6"
    },
