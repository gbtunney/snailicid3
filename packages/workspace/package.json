{
    "name": "@snailicid3/workspace",
    "version": "0.1.1",
    "private": false,
    "description": "Workspace discovery, repository operations, and Snailicid3 workspace commands",
    "keywords": [
        "typescript",
        "snailicid3",
        "monorepo",
        "workspace",
        "repository",
        "cli"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "dev:nx": "nx run $npm_package_name:dev",
        "test:coverage": "vitest run --coverage"
    },
    "nx": {
        "implicitDependencies": [
            "!@snailicid3/config"
        ],
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:vite": {},
            "build:ts": {
                "inputs": [
                    "production",
                    "^production",
                    "{workspaceRoot}/packages/config/typescript-config/**/*"
                ],
                "outputs": [
                    "{projectRoot}/dist",
                    "{projectRoot}/types"
                ]
            },
            "check:ts": {
                "inputs": [
                    "default",
                    "^production",
                    "{workspaceRoot}/packages/config/typescript-config/**/*"
                ]
            },
            "build": {
                "dependsOn": [
                    "build:ts"
                ]
            },
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {}
        }
    },
    "type": "module",
    "bin": {
        "workspace-hook": "./dist/cli/hooks.js",
        "scope-commit": "./dist/cli/commit.js",
        "scope-affected": "./dist/cli/affected.js",
        "gbt-changeset": "./dist/cli/changesetv2.js",
        "gbt-workflow": "./dist/cli/workflow.js",
        "gbt-exec": "./bin/make-executable.sh",
        "gbt-setup": "./bin/completions/install-pnpm.sh",
        "gbt-uninstall": "./bin/uninstall.sh",
        "gbt-patch": "./bin/esbuild-patch/patch.sh"
    },
    "main": "./dist/index.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "CHANGELOG.md",
        "bin/**/*.sh",
        "bin/**/*.md",
        "dist",
        "types"
    ],
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/snailicid3",
        "directory": "packages/workspace"
    },
    "dependencies": {
        "@changesets/assemble-release-plan": "^7.0.0",
        "@changesets/config": "^4.0.0",
        "@changesets/parse": "^1.0.0",
        "@changesets/pre": "^3.0.0",
        "@changesets/read": "^1.0.0",
        "@commitlint/lint": "^21.2.2",
        "@commitlint/load": "^21.2.2",
        "@commitlint/types": "^21.2.0",
        "@snailicid3/logger": "workspace:*",
        "@snailicid3/node-utils": "workspace:*",
        "@snailicid3/utils": "workspace:*",
        "cosmiconfig": "^10.0.0",
        "cosmiconfig-typescript-loader": "^6.3.0",
        "micromatch": "^4.0.8",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@changesets/types": "^7.0.0",
        "@microsoft/api-extractor": "^7.59.0",
        "@snailicid3/config": "workspace:*",
        "@types/micromatch": "^4.0.10",
        "@types/node": "^26.2.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "module": "./dist/index.js"
}
