{
    "name": "@snailicid3/storybook-config",
    "version": "0.1.2",
    "private": false,
    "description": "Shared Storybook config wrapper — framework and addons pre-wired, thin consumer entries",
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "dev:nx": "nx run $npm_package_name:dev",
        "api:report:nx": "nx run $npm_package_name:api:report"
    },
    "nx": {
        "implicitDependencies": [
            "!@snailicid3/config"
        ],
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:tsdown": {},
            "build:ts": {},
            "check:ts": {},
            "build:tsdown": {},
            "build": {
                "dependsOn": [
                    "build:ts",
                    "build:tsdown"
                ]
            },
            "api:report": {},
            "api:check": {},
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {}
        }
    },
    "keywords": [
        "storybook",
        "config",
        "snailicid3",
        "react-vite",
        "monorepo"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "types"
    ],
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/snailicid3",
        "directory": "packages/storybook-config"
    },
    "dependencies": {
        "@snailicid3/config": "workspace:*"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.0",
        "@snailicid3/build-config": "workspace:*",
        "@types/node": "^26.2.0",
        "tsdown": "^0.22.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "module": "./dist/index.js"
}
